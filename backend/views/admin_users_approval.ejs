<!DOCTYPE html>
<html>

<head>
    <title>User Approvals</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">    
    <style>
        body {
            margin: 0;
            font-family: Segoe UI, Arial, sans-serif;
            background: #f1f3f6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .header {
            background: linear-gradient(135deg, #0a3d62, #144f82);
            padding: 18px 40px;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        main {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 20px;
        }

        .wrapper-wide {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 30px;
            flex: 1;
        }

        .card {
            background: #fff;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .15);
        }

        .card h3 {
            margin: 0;
            color: #0a3d62;
        }

        .actions button {
            padding: 8px 16px;
            margin-right: 10px;
            border: none;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
        }

        .approve { background: #28a745; color: #fff; }
        .reject { background: #dc3545; color: #fff; }

        .nav a {
            color: #fff;
            margin-left: 20px;
            text-decoration: none;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 6px;
        }

        .nav a.active { background: rgba(255, 255, 255, 0.2); }

        .list-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .footer {
            background: linear-gradient(135deg, #0a3d62, #144f82);
            text-align: center;
            color: #fff;
            font-size: 14px;
            padding: 20px 40px;
        }

        /* ALERTS */
        .alert {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .alert-success {
            background: #e6f7ee;
            color: #0a7a3c;
            border-left: 5px solid #0a7a3c;
        }

        .alert-error {
            background: #fdecea;
            color: #a4281c;
            border-left: 5px solid #a4281c;
        }


/* =========================
   📱 MOBILE RESPONSIVE
   ========================= */

.hamburger {
    display: none;
    font-size: 26px;
    cursor: pointer;
}

/* Mobile Styles Only */
@media (max-width: 768px) {

    .header {
        background: linear-gradient(135deg, #0a3d62, #144f82);
        padding: 0 18px;
        height: 64px;                 /* fixed height for alignment */
        display: flex;
        justify-content: space-between;
        align-items: center;          /* vertical centering */
        color: #fff;
    }


    .header h1 {
        font-size: 18px;
    }

    .header h2 {
        margin: 0;
        display: flex;
        align-items: center;
    }



    .hamburger {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        cursor: pointer;
        height: 42px;
        width: 42px;
    }



    .nav {
        position: fixed;
        top: 64px;
        right: 0;
        width: 260px;
        background: #0a3d62;
        display: flex;
        flex-direction: column;
        padding: 15px 10px;
        gap: 8px;                 /* spacing between links */
        border-radius: 0 0 0 14px;
        box-shadow: -6px 8px 18px rgba(0,0,0,0.25);
        transform: translateX(100%);
        transition: transform .25s ease;
        z-index: 1000;
    }


    .nav a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 15px;
    }


    .nav a.active {
        background: rgba(255,255,255,0.2);
    }

    .nav.show {
        /* display: flex; */
        transform: translateX(0);
    }

    /* Welcome card stacking */
    .welcome-card {
        grid-template-columns: 1fr;
        padding: 22px;
    }

    .welcome-left {
        flex-direction: column;
        text-align: center;
    }

    .welcome-avatar {
        width: 70px;
        height: 70px;
    }

    .progress-box {
        margin-top: 10px;
    }

    .action-grid {
        gap: 18px;
    }

    .action-card {
        padding: 20px;
    }

    .wrapper {
        margin: 20px auto;
    }

    main {
        padding: 12px;
    }
}

/* small animation */
@keyframes fadeIn {
    from {opacity:0; transform: translateY(-10px);}
    to {opacity:1; transform: translateY(0);}
}


/* ================= PROFILE POPOVER — MOBILE FIX ================= */
@media (max-width: 768px) {

    .profile-popover {
        position: fixed;
        bottom: 0;
        right: 0;
        left: 0;
        top: auto;
        width: 100%;
        border-radius: 20px 20px 0 0;
        padding: 22px 18px 26px;
        box-shadow: 0 -10px 30px rgba(0,0,0,0.25);
        animation: slideUp .25s ease-out;
    }

    .profile-popover::before {
        display: none; /* remove little arrow */
    }

    .profile-top {
        gap: 14px;
        align-items: center;
    }

    .profile-top img {
        width: 60px;
        height: 60px;
    }

    .profile-top h4 {
        font-size: 17px;
    }

    .profile-top p {
        font-size: 14px;
    }

    .btn-outline {
        border-radius: 10px;
        padding: 12px 0;
        font-size: 15px;
    }

    .logout-btn {
        border-radius: 10px;
        padding: 12px 0;
    }

}

/* animation */
@keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}


    </style>
</head>

<body>

<div class="header">
    <h2>User Approvals</h2>
    <div class="hamburger" id="hamburger">
        ☰
    </div>            
    <div class="nav" id="navMenu" >
        <a href="/admin_dashboard">Dashboard</a>
        <a class="active">Approvals</a>
        <a href="/hire_requests">Hire Requests</a>
        <a href="/work_request">Employee Work Requests</a>
    </div>
</div>

<main>
    <div class="wrapper-wide">

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <!-- EMPLOYEES -->
        <% result.employees.forEach(employee => { %>
            <form action="/users_approval" method="post">
                <a href="/view_employee_profile/<%= employee.id %>" class="list-link">
                    <div class="card">
                        <h3>Employee – <%= employee.Name %> (<%= employee.Field %>)</h3>
                        <p>City: <%= employee.Address %> | Experience: <%= employee.experience_year %> years</p>

                        <input type="hidden" name="user_id" value="<%= employee.id %>">
                        <input type="hidden" name="user_type" value="employee">

                        <div class="actions">
                            <button class="approve" type="submit" name="action" value="approve">Approve</button>
                            <button class="reject" type="submit" name="action" value="reject">Reject</button>
                        </div>
                    </div>
                </a>
            </form>
        <% }) %>

        <!-- COMPANIES -->
        <% result.companies.forEach(company => { %>
            <form action="/users_approval" method="post">
                <a href="/view_company_profile/<%= company.id %>" class="list-link">
                    <div class="card">
                        <h3>Company – <%= company.companyname %></h3>
                        <p>Type: <%= company.company_type %> | City: <%= company.city %></p>

                        <input type="hidden" name="user_id" value="<%= company.id %>">
                        <input type="hidden" name="user_type" value="company">

                        <div class="actions">
                            <button class="approve" type="submit" name="action" value="approve">Approve</button>
                            <button class="reject" type="submit" name="action" value="reject">Reject</button>
                        </div>
                    </div>
                </a>
            </form>
        <% }) %>

    </div>
</main>

<div class="footer">
    © 2025 VEDSP Inventive Private Limited – Admin Panel
</div>

<script>
    setTimeout(() => {
        const alerts = document.querySelectorAll(".alert");
        alerts.forEach(a => a.remove());
    }, 3000);


        const hamburger = document.getElementById("hamburger");
        const navMenu = document.getElementById("navMenu");

        hamburger.addEventListener("click", (e) => {
            e.stopPropagation();
            navMenu.classList.toggle("show");
        });

        document.addEventListener("click", (e) => {
            if (!navMenu.contains(e.target) && !hamburger.contains(e.target)) {
                navMenu.classList.remove("show");
            }
        });

</script>

</body>
</html>
