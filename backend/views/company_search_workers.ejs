<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Search Workers</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f3f6;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        /* ===== HEADER ===== */
        
        .header {
            background: linear-gradient(135deg, #0a3d62, #144f82);
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
        }
        
        .header h1 {
            font-size: 22px;
            margin: 0;
        }
        
        .nav {
            display: flex;
            gap: 22px;
            align-items: center;
        }
        
        .nav a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 8px;
        }
        
        .nav a.active {
            background: rgba(255, 255, 255, 0.18);
            box-shadow: 0 4px 12px rgba(0, 0, 0, .25);
        }
        main {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 20px;
        }  

        /* ===== WRAPPER ===== */
        
        .wrapper {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }
        /* ===== TOP BAR ===== */
        
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        
        .top-bar h2 {
            margin: 0;
            color: #0a3d62;
        }
        
        .request-count {
            background: #eef4fb;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            color: #0a3d62;
        }
        /* ===== FILTER BAR ===== */
        
        .filters {
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .15);
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .filters select {
            width: 100%;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
        }
        /* ===== WORKER CARD ===== */
        
        .worker-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .15);
            display: grid;
            grid-template-columns: 80px 1fr auto;
            gap: 20px;
            align-items: center;
        }
        
        .worker-card img {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .worker-info h3 {
            margin: 0;
            color: #0a3d62;
        }
        
        .worker-info .role {
            font-weight: 600;
            color: #555;
            margin: 4px 0;
        }
        
        .worker-info .details {
            font-size: 14px;
            color: #666;
        }
        
        .status {
            margin-top: 6px;
            font-size: 13px;
            color: #28a745;
            font-weight: 600;
        }
        /* ===== BUTTON ===== */
        
        .worker-card button {
            background: #0a3d62;
            color: #fff;
            border: none;
            padding: 10px 18px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }
        
        .worker-card button:hover {
            background: #144f82;
        }
        /* ===== FOOTER ===== */
        
        .footer {
            margin-top: 60px;
            background: linear-gradient(135deg, #0a3d62, #144f82);
            text-align: center;
            color: #fff;
            font-size: 14px;
            padding: 20px;
        }
        
        .profile-wrapper {
            position: relative;
        }
        /* Trigger */
        
        .profile-menu {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        
        .profile-menu img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }
        /* Popover card */
        
        .profile-popover {
            position: absolute;
            top: 58px;
            right: 0;
            width: 260px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
            padding: 14px;
            display: none;
            z-index: 999;
            color: #000;
        }
        
        .profile-top {
            display: flex;
            gap: 12px;
            align-items: center;
            padding-bottom: 12px;
        }
        
        .profile-top img {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .profile-top h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }
        
        .profile-top p {
            margin: 2px 0 0;
            font-size: 13px;
            color: #666;
        }
        
        .profile-popover a,
        .profile-popover button,
        .profile-popover h4,
        .profile-popover p {
            color: #000;
        }
        
        .btn-outline {
            display: block;
            width: 100%;
            text-align: center;
            padding: 8px 0;
            border-radius: 18px;
            border: 1px solid #0a66c2;
            color: #0a66c2;
            font-weight: 600;
            text-decoration: none;
            margin: 8px 0;
        }
        
        .btn-outline:hover {
            background: #eef3f8;
        }
        
        .divider {
            height: 1px;
            background: #e6e6e6;
        }
        
        .logout-btn {
            width: 100%;
            background-color: #ffffff;
            /* border: 2px solid #d0d7de; */
            padding: 8px 0;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            color: #444;
            cursor: pointer;
            /* background-color: none; */
            border: none;
        }
        
        .logout-btn:hover {
            background-color: #f3f6f8;
            border-color: #aab4be;
        }
        
        .profile-popover::before {
            content: "";
            position: absolute;
            top: -8px;
            right: 18px;
            width: 16px;
            height: 16px;
            background: #fff;
            transform: rotate(45deg);
            box-shadow: -2px -2px 6px rgba(0, 0, 0, 0.05);
        }

        /* ===== ALERTS ===== */
        .alert {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .alert-success {
            background: #e6f7ee;
            color: #0a7a3c;
            border-left: 5px solid #0a7a3c;
        }

        .alert-error {
            background: #fdecea;
            color: #a4281c;
            border-left: 5px solid #a4281c;
        }     
/* =========================
   📱 MOBILE RESPONSIVE
   ========================= */

.hamburger {
    display: none;
    font-size: 26px;
    cursor: pointer;
}

/* Mobile Styles Only */
@media (max-width: 768px) {

    .header {
        padding: 16px 18px;
    }

    .header h1 {
        font-size: 18px;
    }

    .hamburger {
        display: block;
        color: white;
    }

    .nav {
        position: absolute;
        top: 70px;
        right: 15px;
        background: #0a3d62;
        flex-direction: column;
        width: 220px;
        border-radius: 10px;
        padding: 15px;
        display: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        animation: fadeIn .2s ease-in-out;
    }

    .nav a {
        padding: 12px;
        width: 100%;
        border-radius: 6px;
    }

    .nav a.active {
        background: rgba(255,255,255,0.2);
    }

    .nav.show {
        display: flex;
    }

    /* Welcome card stacking */
    .welcome-card {
        grid-template-columns: 1fr;
        padding: 22px;
    }

    .welcome-left {
        flex-direction: column;
        text-align: center;
    }

    .welcome-avatar {
        width: 70px;
        height: 70px;
    }

    .progress-box {
        margin-top: 10px;
    }

    .action-grid {
        gap: 18px;
    }

    .action-card {
        padding: 20px;
    }

    .wrapper {
        margin: 20px auto;
    }

    main {
        padding: 12px;
    }
}

/* small animation */
@keyframes fadeIn {
    from {opacity:0; transform: translateY(-10px);}
    to {opacity:1; transform: translateY(0);}
}


/* ================= PROFILE POPOVER — MOBILE FIX ================= */
@media (max-width: 768px) {

    .profile-popover {
        position: fixed;
        bottom: 0;
        right: 0;
        left: 0;
        top: auto;
        width: 100%;
        border-radius: 20px 20px 0 0;
        padding: 22px 18px 26px;
        box-shadow: 0 -10px 30px rgba(0,0,0,0.25);
        animation: slideUp .25s ease-out;
    }

    .profile-popover::before {
        display: none; /* remove little arrow */
    }

    .profile-top {
        gap: 14px;
        align-items: center;
    }

    .profile-top img {
        width: 60px;
        height: 60px;
    }

    .profile-top h4 {
        font-size: 17px;
    }

    .profile-top p {
        font-size: 14px;
    }

    .btn-outline {
        border-radius: 10px;
        padding: 12px 0;
        font-size: 15px;
    }

    .logout-btn {
        border-radius: 10px;
        padding: 12px 0;
    }

}

/* animation */
@keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}        
        
    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="header">
        <h1>Company Dashboard</h1>
        <!-- Hamburger (mobile only) -->
        <div class="hamburger" id="hamburger">
            ☰
        </div>
        <div class="nav" id="navMenu" >
            <a href="/company_dashboard">Dashboard</a>
            <a href="" class="active">Search Workers</a>
            <a href="/company_hire_requests">Hire Requests</a>

            <div class="profile-wrapper">
                <div class="profile-menu" id="profileToggle">
                    <img src="company_logo.jpg" alt="Profile Photo">
                    <span><%= profile.companyname %></span>
                </div>

                <div class="profile-popover" id="profilePopover">
                    <div class="profile-top">
                        <img src="company_logo.jpg" alt="Profile Photo">
                        <div>
                            <h4><%= profile.companyname %></h4>
                        </div>
                    </div>

                    <a href="/company_profile" class="btn-outline">View profile</a>

                    <div class="divider"></div>

                    <button class="logout-btn" ><a href="/logout">Sign out </a></button>
                </div>
            </div>
        </div>
    </div>
    <main>
            <div class="wrapper">
                <% if (error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success"><%= success %></div>
                <% } %>
                <!-- TOP BAR -->
                <div class="top-bar">
                    <h2>Search Workers</h2>
                    <div class="request-count">Sent Requests: <%= count %></div>
                </div>

                <!-- FILTERS -->
                <div class="filters">
                    <select id="empTrade">
                    <option value="">Trade</option>
                    <option value="Mason">Mason</option>
                    <option value="Electrician">Electrician</option>
                    <option value="Plumber">Plumber</option>
                </select>

                <select id="empExperience">
                    <option value="">Experience</option>
                    <option value="1">1+ Years</option>
                    <option value="3">3+ Years</option>
                    <option value="5">5+ Years</option>
                </select>

                <select id="empLocation">
                    <option value="" >Location</option>
                    <option value="Chennai">Chennai</option>
                    <option value="Bangalore">Bangalore</option>
                    <option value="Hyderabad">Hyderabad</option>
                </select>

                <!-- <select>
                    <option>Availability</option>
                    <option>Available</option>
                    <option>Not Available</option>
                </select> -->
                </div>

                <!-- WORKER RESULT -->
                <% if (results && results.length > 0) { %>
                    <% results.forEach(function(result) { %>

                        <form action="/search_workers" method="post">
                            <div class="worker-card employee-item"
                                data-trade="<%= result.Field %>"
                                data-experience="<%= result.experience_year %>"
                                data-location="<%= result.Address %>">

                                <img src="https://i.pravatar.cc/100?img=12" alt="Worker">

                                <div class="worker-info">
                                    <h3><%= result.Name %></h3>
                                    <input type="hidden" name="user_id" value="<%= result.id %>">

                                    <div class="role"><%= result.Field %></div>

                                    <div class="details">
                                        <%= result.experience_year %> Years Experience |
                                        <%= result.secondarySkills || '' %>, <%= result.Tools || '' %>
                                    </div>
                                </div>

                                <% if (result.hire_status && result.hire_status.status === "PENDING") { %>
                                    <button type="button" disabled style="background:#999">
                                        Request Sent
                                    </button>
                                <% } else { %>
                                    <button type="submit" name="action" value="send_request">
                                        Send Hire Request
                                    </button>
                                <% } %>

                            </div>
                        </form>
                    <% }) %>
                <% } %>    
            </div>
    </main>

    <div class="footer">
        © 2025 VEDSP Inventive Private Limited. All rights reserved.
    </div>

    <script>
        const toggle = document.getElementById("profileToggle");
        const popover = document.getElementById("profilePopover");

        toggle.addEventListener("click", (e) => {
            e.stopPropagation();
            popover.style.display =
                popover.style.display === "block" ? "none" : "block";
        });

        document.addEventListener("click", () => {
            popover.style.display = "none";
        });

        function goHome() {
            window.location.href = "Home.html";
        }

        function filterEmployees() {
            const trade = document.getElementById("empTrade").value;
            const experience = document.getElementById("empExperience").value;
            const location = document.getElementById("empLocation").value;

            document.querySelectorAll(".employee-item").forEach(card => {

                const empTrade = card.dataset.trade;
                const empExperience = Number(card.dataset.experience || 0);
                const empLocation = card.dataset.location || "";

                const matchTrade = !trade || empTrade === trade;
                const matchExperience = !experience || empExperience >= Number(experience);
                const matchLocation = !location || empLocation.includes(location);

                card.style.display =
                    (matchTrade && matchExperience && matchLocation)
                        ? "grid"
                        : "none";
            });
        }

        // Attach listeners
        document
        .querySelectorAll("#empTrade, #empExperience, #empLocation")
        .forEach(select => select.addEventListener("change", filterEmployees));

        setTimeout(() => {
            const alerts = document.querySelectorAll(".alert");
            alerts.forEach(a => a.remove());
        }, 3000);        



        const hamburger = document.getElementById("hamburger");
        const navMenu = document.getElementById("navMenu");

        hamburger.addEventListener("click", (e) => {
            e.stopPropagation();
            navMenu.classList.toggle("show");
        });

        document.addEventListener("click", (e) => {
            if (!navMenu.contains(e.target) && !hamburger.contains(e.target)) {
                navMenu.classList.remove("show");
            }
        });


    </script>
</body>

</html>