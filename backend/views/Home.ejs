<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>BuildCrew</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f3f6;
            color: #333;
        }
        /* ===== HEADER ===== */
        
        .header {
            background: #0a3d62;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
        }
        
        .header h1 {
            font-size: 22px;
            margin: 0;
        }
        
        .header .nav a {
            color: #fff;
            margin-left: 20px;
            text-decoration: none;
            font-weight: 600;
        }
        /* ===== HERO ===== */
        
        .hero {
            padding: 80px 20px;
            background: linear-gradient(135deg, #0a3d62, #144f82);
            color: #fff;
            text-align: center;
        }
        
        .hero h2 {
            /* font-size: 36px; */
            margin-bottom: 15px;
            font-size: 40px;
            line-height: 1.2;
        }
        
        .hero p {
            font-size: 18px;
            max-width: 700px;
            margin: auto;
            opacity: 0.95;
        }
        /* ===== SECTIONS ===== */
        
        .section {
            max-width: 1100px;
            margin: 60px auto;
            padding: 0 20px;
        }
        
        .section-title {
            font-size: 26px;
            font-weight: 600;
            color: #0a3d62;
            text-align: center;
            margin-bottom: 40px;
        }
        /* ===== ROLE CARDS ===== */
        
        .role-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }
        
        .role-card {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            /* box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15); */
            box-shadow: 0 10px 30px rgba(10, 61, 98, 0.18);
            text-align: center;
        }
        
        .role-card h3 {
            color: #0a3d62;
            margin-bottom: 10px;
        }
        
        .role-card p {
            color: #555;
            margin-bottom: 20px;
        }
        
        .role-card a {
            display: inline-block;
            padding: 12px 24px;
            background: #0a3d62;
            color: #fff;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
        }
        /* ===== HOW IT WORKS ===== */
        
        .steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }
        
        .step-box {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        }
        
        .step-box h4 {
            color: #0a3d62;
            margin-bottom: 10px;
        }
        /* ===== TRUST ===== */
        
        .trust {
            background: #eef4fb;
            padding: 60px 20px;
        }
        
        .trust-grid {
            max-width: 1100px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 30px;
        }
        
        .trust-box {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        }
        
        .trust-box h4 {
            color: #0a3d62;
            margin-bottom: 10px;
        }
        /* ===== FOOTER ===== */
        
        .footer {
            background: #0a3d62;
            color: #fff;
            text-align: center;
            padding: 20px;
            font-size: 14px;
        }
        
        .header .nav .admin-link {
            opacity: 0.75;
            font-size: 14px;
        }
        
        .header .nav .admin-link:hover {
            opacity: 1;
            text-decoration: underline;
        }
        
        .section {
            background: transparent;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="header">
        <h1>BuildCrew</h1>
        <div class="nav">
            <a href="/employee_login">Employee Login</a>
            <a href="/company_login">Company Login</a>
            <a href="/admin_login" class="admin-link">Admin</a>
        </div>

    </div>

    <!-- HERO -->
    <div class="hero">
        <h2>Verified Construction Workers. Trusted Companies.</h2>
        <p>
            A secure hiring platform for the construction industry — where workers are protected and companies hire with confidence.
        </p>
    </div>

    <!-- ROLE SELECTION -->
    <div class="section">
        <div class="section-title">Get Started</div>
        <div class="role-cards">
            <div class="role-card">
                <h3>For Workers</h3>
                <p>Create your verified profile and get hired by trusted companies.</p>
                <a href="/employee_register">Register as Employee</a>
            </div>

            <div class="role-card">
                <h3>For Companies</h3>
                <p>Find skilled construction workers after admin verification.</p>
                <a href="/company_register">Register as Company</a>
            </div>
        </div>
    </div>

    <!-- HOW IT WORKS -->
    <div class="section">
        <div class="section-title">How It Works</div>
        <div class="steps">
            <div class="step-box">
                <h4>1. Register</h4>
                <p>Employees and companies create verified profiles.</p>
            </div>
            <div class="step-box">
                <h4>2. Admin Review</h4>
                <p>Admin verifies authenticity to protect all users.</p>
            </div>
            <div class="step-box">
                <h4>3. Search & Request</h4>
                <p>Companies search workers and send hire requests.</p>
            </div>
            <div class="step-box">
                <h4>4. Contact Shared</h4>
                <p>Contact details are shared only after admin approval.</p>
            </div>
        </div>
    </div>

    <!-- TRUST -->
    <div class="trust">
        <div class="section-title">Why Trust This Platform?</div>
        <div class="trust-grid">
            <div class="trust-box">
                <h4>Admin Controlled</h4>
                <p>No direct access. Every profile and request is reviewed.</p>
            </div>
            <div class="trust-box">
                <h4>Worker Privacy</h4>
                <p>Phone numbers are shared only after approval.</p>
            </div>
            <div class="trust-box">
                <h4>Construction-Focused</h4>
                <p>Built specifically for construction hiring — not generic jobs.</p>
            </div>
        </div>
    </div>
    <hr style="border:none;height:1px;background:#dbe4f0;margin:0;">

    <!-- FOOTER -->
    <div class="footer">
        © 2025 VEDSP Inventive Private Limited. All rights reserved.
    </div>

    <script>
        if(message){ alert(message); }
    </script>

</body>

</html>