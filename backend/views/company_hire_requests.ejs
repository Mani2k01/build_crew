<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Hire Requests</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f3f6;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        /* ===== HEADER ===== */
        
        .header {
            background: linear-gradient(135deg, #0a3d62, #144f82);
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
        }
        
        .header h1 {
            font-size: 22px;
            margin: 0;
        }
        
        .nav {
            display: flex;
            gap: 22px;
            align-items: center;
        }
        
        .nav a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            padding: 8px 18px;
            border-radius: 8px;
        }
        
        .nav a.active {
            background: rgba(255, 255, 255, 0.18);
            box-shadow: 0 4px 12px rgba(0, 0, 0, .25);
        }
        
        .nav a:hover {
            background: rgba(255, 255, 255, 0.12);
        }
        /* ===== WRAPPER ===== */
        
        .wrapper-wide {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 30px;
            flex: 1;
        }
        /* ===== PAGE TITLE ===== */
        
        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #0a3d62;
            margin-bottom: 25px;
        }
        /* ===== REQUEST CARD ===== */
        
        .request-card {
            background: #fff;
            border-radius: 10px;
            padding: 22px;
            margin-bottom: 18px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .14);
        }
        
        .request-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .request-header h3 {
            margin: 0;
            color: #0a3d62;
        }
        
        .badge {
            padding: 6px 14px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 600;
        }
        /* Status badges */
        
        .pending {
            background: #fff3cd;
            color: #856404;
        }
        
        .approved {
            background: #d4edda;
            color: #155724;
        }
        
        .rejected {
            background: #f8d7da;
            color: #721c24;
        }
        
        .request-body {
            margin-top: 10px;
            font-size: 14px;
            color: #555;
        }
        
        .request-body span {
            display: block;
            margin-top: 4px;
        }
        main {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 20px;
        }  

        /* ===== FOOTER ===== */
        
        .footer {
            background: linear-gradient(135deg, #0a3d62, #144f82);
            text-align: center;
            color: #fff;
            font-size: 14px;
            padding: 20px 40px;
        }
        
        .profile-wrapper {
            position: relative;
        }
        /* Trigger */
        
        .profile-menu {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        
        .profile-menu img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }
        /* Popover card */
        
        .profile-popover {
            position: absolute;
            top: 58px;
            right: 0;
            width: 260px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
            padding: 14px;
            display: none;
            z-index: 999;
            color: #000;
        }
        
        .profile-top {
            display: flex;
            gap: 12px;
            align-items: center;
            padding-bottom: 12px;
        }
        
        .profile-top img {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .profile-top h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }
        
        .profile-top p {
            margin: 2px 0 0;
            font-size: 13px;
            color: #666;
        }
        
        .profile-popover a,
        .profile-popover button,
        .profile-popover h4,
        .profile-popover p {
            color: #000;
        }
        
        .btn-outline {
            display: block;
            width: 100%;
            text-align: center;
            padding: 8px 0;
            border-radius: 18px;
            border: 1px solid #0a66c2;
            color: #0a66c2;
            font-weight: 600;
            text-decoration: none;
            margin: 8px 0;
        }
        
        .btn-outline:hover {
            background: #eef3f8;
        }
        
        .divider {
            height: 1px;
            background: #e6e6e6;
        }
        
        .logout-btn {
            width: 100%;
            background-color: #ffffff;
            /* border: 2px solid #d0d7de; */
            padding: 8px 0;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            color: #444;
            cursor: pointer;
            /* background-color: none; */
            border: none;
        }
        
        .logout-btn:hover {
            background-color: #f3f6f8;
            border-color: #aab4be;
        }
        
        .profile-popover::before {
            content: "";
            position: absolute;
            top: -8px;
            right: 18px;
            width: 16px;
            height: 16px;
            background: #fff;
            transform: rotate(45deg);
            box-shadow: -2px -2px 6px rgba(0, 0, 0, 0.05);
        }


/* =========================
   📱 MOBILE RESPONSIVE
   ========================= */

.hamburger {
    display: none;
    font-size: 26px;
    cursor: pointer;
}

/* Mobile Styles Only */
@media (max-width: 768px) {

    .header {
        padding: 16px 18px;
    }

    .header h1 {
        font-size: 18px;
    }

    .hamburger {
        display: block;
        color: white;
    }

    .nav {
        position: absolute;
        top: 70px;
        right: 15px;
        background: #0a3d62;
        flex-direction: column;
        width: 220px;
        border-radius: 10px;
        padding: 15px;
        display: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        animation: fadeIn .2s ease-in-out;
    }

    .nav a {
        padding: 12px;
        width: 100%;
        border-radius: 6px;
    }

    .nav a.active {
        background: rgba(255,255,255,0.2);
    }

    .nav.show {
        display: flex;
    }

    /* Welcome card stacking */
    .welcome-card {
        grid-template-columns: 1fr;
        padding: 22px;
    }

    .welcome-left {
        flex-direction: column;
        text-align: center;
    }

    .welcome-avatar {
        width: 70px;
        height: 70px;
    }

    .progress-box {
        margin-top: 10px;
    }

    .action-grid {
        gap: 18px;
    }

    .action-card {
        padding: 20px;
    }

    .wrapper {
        margin: 20px auto;
    }

    main {
        padding: 12px;
    }
}

/* small animation */
@keyframes fadeIn {
    from {opacity:0; transform: translateY(-10px);}
    to {opacity:1; transform: translateY(0);}
}


/* ================= PROFILE POPOVER — MOBILE FIX ================= */
@media (max-width: 768px) {

    .profile-popover {
        position: fixed;
        bottom: 0;
        right: 0;
        left: 0;
        top: auto;
        width: 100%;
        border-radius: 20px 20px 0 0;
        padding: 22px 18px 26px;
        box-shadow: 0 -10px 30px rgba(0,0,0,0.25);
        animation: slideUp .25s ease-out;
    }

    .profile-popover::before {
        display: none; /* remove little arrow */
    }

    .profile-top {
        gap: 14px;
        align-items: center;
    }

    .profile-top img {
        width: 60px;
        height: 60px;
    }

    .profile-top h4 {
        font-size: 17px;
    }

    .profile-top p {
        font-size: 14px;
    }

    .btn-outline {
        border-radius: 10px;
        padding: 12px 0;
        font-size: 15px;
    }

    .logout-btn {
        border-radius: 10px;
        padding: 12px 0;
    }

}

/* animation */
@keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="header">
        <h1>Company Dashboard</h1>
        <!-- Hamburger (mobile only) -->
        <div class="hamburger" id="hamburger">
            ☰
        </div>

        <div class="nav" id="navMenu">
            <a href="/company_dashboard">Dashboard</a>
            <a href="/search_workers">Search Workers</a>
            <a href="" class="active">Hire Requests</a>

            <div class="profile-wrapper">
                <div class="profile-menu" id="profileToggle">
                    <img src="company_logo.jpg" alt="Profile Photo">
                    <span><%= profile.companyname %></span>
                </div>

                <div class="profile-popover" id="profilePopover">
                    <div class="profile-top">
                        <img src="company_logo.jpg" alt="Profile Photo">
                        <div>
                            <h4><%= profile.companyname %></h4>
                        </div>
                    </div>

                    <a href="/company_profile" class="btn-outline">View profile</a>

                    <div class="divider"></div>

                    <button class="logout-btn" ><a href="/logout">Sign out </a></button>
                </div>
            </div>
        </div>
    </div>

    <main>
        <div class="wrapper-wide">

            <div class="page-title">Hire Requests</div>

            <% if (results && results.length > 0) { %>
                <% results.forEach(function(result) { %>

                    <div class="request-card">
                        <div class="request-header">
                            <h3><%= result.Name %> — <%= result.Field %></h3>

                            <% if (result.hire_status.status === "PENDING") { %>
                                <span class="badge pending">Pending Admin Approval</span>
                            <% } else if (result.hire_status.status === "APPROVED") { %>
                                <span class="badge approved">Approved · Contact Shared</span>
                            <% } else { %>
                                <span class="badge rejected">Rejected by Admin</span>
                            <% } %>

                        </div>

                        <div class="request-body">
                            <span>📍 <%= result.Address %></span>

                            <% if (result.hire_status) { %>
                                <span>
                                    🗓 Requested on:
                                    <%= new Date(result.hire_status.updated_at).toDateString() %>
                                </span>
                            <% } %>
                        </div>
                    </div>

                <% }) %>
            <% } %>

        </div>
    </main>


    <!-- FOOTER -->
    <div class="footer">
        © 2025 VEDSP Inventive Private Limited. All rights reserved.
    </div>
    <script>
        const toggle = document.getElementById("profileToggle");
        const popover = document.getElementById("profilePopover");

        toggle.addEventListener("click", (e) => {
            e.stopPropagation();
            popover.style.display =
                popover.style.display === "block" ? "none" : "block";
        });

        document.addEventListener("click", () => {
            popover.style.display = "none";
        });

        function goHome() {
            window.location.href = "Home.html";
        }



        const hamburger = document.getElementById("hamburger");
        const navMenu = document.getElementById("navMenu");

        hamburger.addEventListener("click", (e) => {
            e.stopPropagation();
            navMenu.classList.toggle("show");
        });

        document.addEventListener("click", (e) => {
            if (!navMenu.contains(e.target) && !hamburger.contains(e.target)) {
                navMenu.classList.remove("show");
            }
        });


    </script>

</body>

</html>