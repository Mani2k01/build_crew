<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Employee Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f3f6;
            color: #333;
        }
        /* ===== HEADER ===== */
        
        .header {
            background: #0a3d62;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
        }
        
        .header h1 {
            font-size: 22px;
            margin: 0;
        }
        
        .header a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }
        /* ===== WRAPPER ===== */
        
        .wrapper {
            max-width: 480px;
            margin: 80px auto;
            padding: 0 20px;
        }
        /* ===== CARD ===== */
        
        .card {
            background: #fff;
            border-radius: 10px;
            padding: 35px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        }
        
        .card h2 {
            text-align: center;
            color: #0a3d62;
            margin-bottom: 25px;
        }
        /* ===== FORM ===== */
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }
        
        .form-group input {
            width: 100%;
            padding: 12px;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 15px;
        }
        
        .form-group input:focus {
            outline: none;
            border-color: #0a3d62;
            box-shadow: 0 0 0 2px rgba(10, 61, 98, 0.15);
        }
        /* ===== ACTION ===== */
        
        .login-btn {
            width: 100%;
            padding: 12px;
            background: #0a3d62;
            color: #fff;
            font-size: 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 10px;
        }
        /* ===== HELP LINKS ===== */
        
        .help {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
        }
        
        .help a {
            color: #0a3d62;
            text-decoration: none;
            font-weight: 600;
        }
        /* ===== STATUS BOX ===== */
        
        .status-box {
            margin-top: 25px;
            padding: 15px;
            border-radius: 6px;
            background: #eef4fb;
            border-left: 4px solid #0a3d62;
            font-size: 14px;
        }
        /* ===== FOOTER ===== */
        
        .footer {
            text-align: center;
            margin-top: 60px;
            font-size: 14px;
            color: #888;
        }

        /* ===== ALERTS ===== */
        .alert {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            }

            .alert-success {
            background: #e6f7ee;
            color: #0a7a3c;
            border-left: 5px solid #0a7a3c;
            }

            .alert-error {
            background: #fdecea;
            color: #a4281c;
            border-left: 5px solid #a4281c;
            }        
    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="header">
        <h1>BuildCrew</h1>
        <a href="/">Home</a>
    </div>

    <!-- LOGIN -->
    <div class="wrapper">
        <div class="card">
            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>

            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <h2>Employee Login</h2>

            <form id="loginForm" action="/employee_login" method="post" >
                <div class="form-group">
                    <label>Email or Mobile Number</label>
                    <input type="text" name="email" placeholder="Enter registered email or mobile" required>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Enter password" required>
                </div>

                <button class="login-btn" type="submit" action="submit" value="login">Login</button>
            </form>

            <div class="help">
                <a href="#">Forgot Password?</a><br><br> New user? <a href="/employee_register">Register here</a>
            </div>

        </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
        © 2025 VEDSP Inventive Private Limited. All rights reserved.
    </div>
    <script>
        function goEmp_Dashboard() {
            alert("Logged in Successfully..")
            window.location.href = "employee_dashboard.html";
        }

        setTimeout(() => {
            const alerts = document.querySelectorAll(".alert");
            alerts.forEach(a => a.remove());
        }, 3000);


    </script>

</body>

</html>